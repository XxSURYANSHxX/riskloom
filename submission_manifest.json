  "known_limitations": [
    {
      "name": "live_state_outcome_blind_spot",
      "summary": "The 18 failure-derived features read low before outcomes exist; held-out metrics are not live-serving accuracy.",
      "evidence_path": "docs/BUILD_LOG.md"
    },
    {
      "name": "boundary_spaced_evasion",
      "summary": "Measured synthetic boundary spacing reduced event recall to between 0.00 and 0.12; exact 3600-second spacing detected 0 of 120 attack events.",
      "evidence_path": "docs/BUILD_LOG.md"
    },
    {
      "name": "decision_threshold_tie_cluster",
      "summary": "The locked threshold is one float64 step above an eight-row policy-selection probability cluster; the diagnostic is non-fatal and held-out metrics are unaffected.",
      "evidence_path": "docs/BUILD_LOG.md"
    },
    {
      "name": "local_shadow_mode_boundaries",
      "summary": "Live feature state is per process, review items have no resolution workflow, and a frozen database failure is safe but not bounded server-side.",
      "evidence_path": "README.md"
    }
