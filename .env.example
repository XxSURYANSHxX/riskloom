RISKLOOM_ENVIRONMENT=local
RISKLOOM_LOG_LEVEL=INFO
RISKLOOM_DATABASE_URL=postgresql+asyncpg://riskloom:riskloom_local_only@127.0.0.1:5432/riskloom
RISKLOOM_DATABASE_CONNECT_TIMEOUT_SECONDS=3
RISKLOOM_RAZORPAY_KEY_ID=rzp_test_replace_me
RISKLOOM_RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RISKLOOM_RAZORPAY_WEBHOOK_SECRET=replace_with_at_least_32_characters
RISKLOOM_WEBHOOK_MAX_BODY_BYTES=262144

RISKLOOM_POSTGRES_DB=riskloom
RISKLOOM_POSTGRES_USER=riskloom
RISKLOOM_POSTGRES_PASSWORD=riskloom_local_only
RISKLOOM_POSTGRES_PORT=5432
